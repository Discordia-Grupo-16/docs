%% Discordia - Arquitectura de alto nivel
%% Fuente unica del diagrama. Editar aca, no en una imagen exportada.
%% Ver: adr/0001, adr/0002, adr/0003, adr/0008, adr/0009, adr/0010
%% Dos caminos, y no hay que mezclarlos:
%%   cliente -> gateway -> servicio : HTTP sincronico, el gateway hace de proxy (ADR-0009)
%%   servicio -> bus -> consumidores: eventos, asincronico, unica via entre servicios
%% No hay flechas servicio -> servicio: el ADR-0004 rechazo las llamadas sincronicas internas.
%% El gateway no publica al bus: el evento lo publica el servicio dueno del recurso.

flowchart TB
    subgraph clientes["Artefactos cliente"]
        web["web-app<br/>React"]
        bo["backoffice<br/>React"]
        mob["mobile<br/>React Native"]
    end

    gw["api-gateway<br/>Go<br/>auth JWT / rate limit / ruteo / proxy"]

    redis[("Redis<br/>blacklist de tokens")]

    subgraph python["Python + FastAPI + PostgreSQL"]
        identity["identity<br/>usuarios / auth / perfil"]
        community["community<br/>servidores / canales / invitaciones"]
        mod["mod<br/>moderacion / roles / baneos"]
        monetization["monetization<br/>suscripciones / pagos"]
    end

    subgraph golang["Go"]
        chat["chat-and-real-time<br/>MongoDB<br/>mensajeria + voz"]
        notif["notifications<br/>sin DB propia"]
        metrics["metrics<br/>PostgreSQL"]
    end

    bus{{"Bus Pub/Sub<br/>RabbitMQ - ADR-0003 propuesto"}}

    fcm[("Firebase<br/>Cloud Messaging")]

    web --> gw
    bo --> gw
    mob --> gw

    gw -- "HTTP sincronico<br/>ADR-0009" --> identity
    gw -- "HTTP sincronico<br/>ADR-0009" --> community
    gw -- "HTTP sincronico<br/>ADR-0009" --> chat
    gw == "WebSocket<br/>ADR-0008" ==> chat
    gw -. "sin contrato todavia" .-> mod
    gw -. "sin contrato todavia" .-> monetization

    gw -- "consulta jti<br/>ADR-0010" --> redis
    identity -- "escribe jti en logout<br/>ADR-0010" --> redis

    identity <--> bus
    community <--> bus
    mod <--> bus
    monetization <--> bus
    chat <--> bus
    bus --> notif
    bus --> metrics

    notif --> fcm

    classDef pendiente stroke-dasharray: 5 5
    class bus pendiente
